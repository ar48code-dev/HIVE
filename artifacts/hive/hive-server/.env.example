# Copy to .env. NEVER commit .env. Sandbox credentials only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
HIVE_PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
DATABASE_URL=
CUSTOMER_HASH_SALT=
PORT=8080

# Optional: Gemini through Vertex AI. Without this configuration, Queen uses deterministic templates.
GCP_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us
# Add the full service-account JSON through the host's secret store, never in source.
GOOGLE_SERVICE_ACCOUNT_JSON=
GEMINI_MODEL=gemini-3.8-flash
# DEMO_MODE=true runs with synthetic data and no database (default when DATABASE_URL is empty).
DEMO_MODE=

# AG Studio licence key (free 45-day trial linked from the hackathon's AG Grid page). Without it Studio shows a trial watermark.
AG_STUDIO_LICENSE=
# REQUIRED whenever DATABASE_URL is set (the server refuses to start without it). Approving actions, changing alert
# status and backfill need it. In demo mode (no database) it may stay empty.
ADMIN_TOKEN=
# Set to true with Vertex AI configured to save validated answers for replay when the model is down.
RECORD_ANSWERS=

# Optional brain (learned router, note screening, risk second opinion). Leave BRAIN_URL empty to disable. Run it with: npm run brain
# If the brain is on a public address it requires BRAIN_TOKEN, and HIVE must send the same value.
BRAIN_URL=
BRAIN_TOKEN=

# Agent Gate (MCP server at /mcp). Other AI agents send this as "Authorization: Bearer <token>".
# Required outside demo mode; leave empty in demo mode (synthetic data only).
AGENT_TOKEN=
# Most money HIVE may pay out in any rolling 24 hours, in cents (10000 = $100.00).
PAYOUT_DAILY_CAP_CENTS=10000

# Recipient for direct HIVE alert email through the connected Gmail integration. This is an address, not a credential.
HIVE_ALERT_EMAIL_TO=
HIVE_ALERT_MIN_SEVERITY=medium
PUBLIC_URL=
