{
  "name": "@workspace/hive",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p hive-server/tsconfig.build.json && vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc --noEmit -p hive-server/tsconfig.json",
    "test": "cd hive-server && env DATABASE_URL='' DEMO_MODE=true HIVE_DISABLE_GEMINI=true vitest run tests",
    "wasplab": "cd hive-server && tsx src/wasplab/cli.ts",
    "stress": "cd hive-server && tsx scripts/stress.ts",
    "paypal:smoke": "cd hive-server && tsx scripts/paypal-smoke.ts",
    "webhook:register": "cd hive-server && tsx scripts/register-webhook.ts",
    "db:init": "cd hive-server && tsx scripts/init-db.ts",
    "backfill": "cd hive-server && tsx scripts/backfill.ts",
    "wasplab:live": "cd hive-server && tsx scripts/wasplab-live.ts"
  },
